#Copy an extracted voice release, without bringing its build or source tree.
if(NOT EXISTS "${VOICE_RUNTIME}/BUILD.txt" OR NOT EXISTS "${VOICE_RUNTIME}/LICENSE")
    message(FATAL_ERROR "GFX_VOICE_RUNTIME_DIR must point to an extracted realtime-voice release")
endif()
file(MAKE_DIRECTORY "${VOICE_DESTINATION}")
foreach(name voice_client voice_server voice_client.exe voice_server.exe BUILD.txt LICENSE)
    if(EXISTS "${VOICE_RUNTIME}/${name}")
        file(COPY "${VOICE_RUNTIME}/${name}" DESTINATION "${VOICE_DESTINATION}")
    endif()
endforeach()
file(GLOB voice_dlls "${VOICE_RUNTIME}/*.dll")
if(voice_dlls)
    file(COPY ${voice_dlls} DESTINATION "${VOICE_DESTINATION}")
endif()
foreach(directory bin lib share licenses)
    if(EXISTS "${VOICE_RUNTIME}/${directory}")
        file(COPY "${VOICE_RUNTIME}/${directory}" DESTINATION "${VOICE_DESTINATION}")
    endif()
endforeach()
